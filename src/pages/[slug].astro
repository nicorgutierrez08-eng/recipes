---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IngredientsPanel from '../components/IngredientsPanel.tsx';
import { labelize } from '../lib/format';
import '../styles/recipe.css';

export async function getStaticPaths() {
  const entries = await getCollection('recipes');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function inlineMd(s: string): string {
  let out = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/`(.+?)`/g, '<code>$1</code>');
  return out;
}

const blocks = entry.body.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
const steps: string[] = [];
const notes: string[] = [];
for (const b of blocks) {
  if (b.startsWith('>')) notes.push(inlineMd(b.replace(/^>\s?/gm, '').replace(/\n/g, ' ').trim()));
  else steps.push(inlineMd(b.replace(/\n/g, ' ').trim()));
}

const timeText =
  d.totalTimeMin != null
    ? d.totalTimeMin >= 60
      ? `${Math.floor(d.totalTimeMin / 60)} h${d.totalTimeMin % 60 ? ' ' + (d.totalTimeMin % 60) + ' min' : ''}`
      : `${d.totalTimeMin} min`
    : d.totalTimeText;

const facts = [
  timeText ? { label: 'Total', value: timeText } : null,
  d.servings ? { label: 'Serves', value: String(d.servings) } : null,
  d.difficulty ? { label: 'Difficulty', value: d.difficulty } : null,
  d.cost ? { label: 'Cost', value: d.cost } : null,
  d.nutrition?.calories ? { label: 'Calories', value: d.nutrition.calories } : null,
].filter(Boolean) as Array<{ label: string; value: string }>;

const metaRows = [
  ['Meal', d.meal],
  ['Cuisine', d.cuisine],
  ['Protein', d.protein],
  ['Dietary', d.dietary],
  ['Allergens', d.allergens],
  ['Equipment', d.equipment],
  ['Method', d.cookingMethod],
  ['Flavor', d.flavor],
  ['Texture', d.texture],
  ['Meal prep', d.mealPrep],
  ['Freezer', d.freezer],
  ['Storage', d.storage],
].filter(([, v]) => v) as Array<[string, string]>;

const macros = [
  ['Protein', d.nutrition?.protein],
  ['Carbs', d.nutrition?.carbs],
  ['Fat', d.nutrition?.fat],
  ['Fiber', d.nutrition?.fiber],
  ['Sugar', d.nutrition?.sugar],
  ['Sodium', d.nutrition?.sodium],
].filter(([, v]) => v) as Array<[string, string]>;

const VLABEL: Record<string, string> = {
  A: 'Caption largely available — close to cookable',
  B: 'Useful partial recipe — a quantity or step may be missing',
  C: 'Concept known — method is a conservative outline',
  D: 'Could not be identified — needs a screenshot or caption',
};
---

<Base title={`${d.title} — The Pantry`} description={d.description ?? d.title}>
  <article class="recipe">
    <div class="container recipe__inner">
      <a id="back-link" class="back-link" href={`${base}/`}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        Back to the library
      </a>

      <header class="recipe__header recipe__header--solo">
        <div class="recipe__headtext">
          <div class="recipe__eyebrow">
            <span class="codeword recipe__codeword">{d.id}</span>
            {d.verification && (
              <span class={`vbadge vbadge--${d.verification}`} title={VLABEL[d.verification]}>Level {d.verification}</span>
            )}
          </div>
          <h1 class="recipe__title">{d.title}</h1>
          {d.description && <p class="recipe__desc">{d.description}</p>}

          <dl class="facts">
            {facts.map((f) => (
              <div class="facts__item"><dt>{f.label}</dt><dd>{f.value}</dd></div>
            ))}
          </dl>

          {d.source && (
            <p class="recipe__source">
              <a href={d.source} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
                View original reel
              </a>
            </p>
          )}
        </div>
      </header>

      {metaRows.length > 0 && (
        <div class="metatags">
          {metaRows.map(([label, value]) => (
            <div class="metatags__row">
              <span class="metatags__label">{label}</span>
              <span class="metatags__value">{value}</span>
            </div>
          ))}
        </div>
      )}

      <hr class="perforation recipe__rule" />

      <div class="recipe__cols">
        <aside class="recipe__aside">
          {d.ingredients && d.ingredients.length > 0 ? (
            <IngredientsPanel client:load ingredients={d.ingredients} baseServings={d.servings ?? 1} />
          ) : (
            <div class="ingredients">
              <h2 class="section-title">Ingredients</h2>
              <p class="ingredients__hint">Ingredient list wasn't recovered from the source for this one.</p>
            </div>
          )}

          {(d.nutrition?.calories || macros.length > 0) && (
            <div class="nutrition">
              <h3 class="nutrition__title">Nutrition {d.nutrition?.serving ? <span class="nutrition__serving">· {d.nutrition.serving}</span> : null}</h3>
              <div class="nutrition__grid">
                {d.nutrition?.calories && (
                  <div class="nutrition__cell nutrition__cell--cal"><span class="nutrition__num">{d.nutrition.calories}</span><span class="nutrition__lab">calories</span></div>
                )}
                {macros.map(([label, value]) => (
                  <div class="nutrition__cell"><span class="nutrition__num">{value}</span><span class="nutrition__lab">{label}</span></div>
                ))}
              </div>
              {d.nutrition?.status && <p class="nutrition__status">{labelize(d.nutrition.status)} values</p>}
            </div>
          )}
        </aside>

        <section class="method">
          {steps.length > 0 && (
            <>
              <h2 class="section-title">Method</h2>
              <ol class="steps">
                {steps.map((s) => (
                  <li class="step"><div class="step__text" set:html={s} /></li>
                ))}
              </ol>
            </>
          )}

          {notes.length > 0 && (
            <div class="notes">
              {notes.map((n) => (
                <p class="note" set:html={n} />
              ))}
            </div>
          )}
        </section>
      </div>
    </div>
  </article>

  <script define:vars={{ base }}>
    const params = new URLSearchParams(window.location.search);
    const from = params.get('from');
    if (from) {
      const link = document.getElementById('back-link');
      if (link) link.setAttribute('href', `${base}/?${from}`);
    }
  </script>
</Base>
